---
/**
 * 鼠标墨迹：墨汁滴入水中的立体扩散。
 * 粒子走大幅螺旋路径并彼此交叉编织，沿途留下大而软的墨点，
 * 叠成连续的墨云；溶解层让墨云「前沿浓、尾部散」，像在水中翻滚稀释。
 * 颜色跟随主题（亮色浓墨 / 暗色淡墨）。
 */
---

<canvas id="ink-trail" class="pointer-events-none fixed inset-0 z-0" aria-hidden="true"></canvas>

<script is:inline>
  (function () {
    var canvas = document.getElementById('ink-trail');
    var ctx = canvas.getContext('2d');
    var dpr = Math.min(window.devicePixelRatio || 1, 2);

    // 墨迹累积层：墨点在此层累积，整层随时间溶解
    var ink = document.createElement('canvas');
    var inkCtx = ink.getContext('2d');

    function resize() {
      canvas.width = Math.floor(window.innerWidth * dpr);
      canvas.height = Math.floor(window.innerHeight * dpr);
      ink.width = canvas.width;
      ink.height = canvas.height;
    }
    resize();
    window.addEventListener('resize', resize);

    function inkRGB() {
      var v = getComputedStyle(document.documentElement).getPropertyValue('--ink').trim();
      var m = /^#([0-9a-f]{6})$/i.exec(v);
      if (!m) return [43, 42, 38];
      var n = parseInt(m[1], 16);
      return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    }

    // 软边墨点精灵：预渲染径向渐变图章
    var sprite = document.createElement('canvas');
    sprite.width = 64;
    sprite.height = 64;
    function makeSprite(rgb) {
      var s = sprite.getContext('2d');
      s.clearRect(0, 0, 64, 64);
      var g = s.createRadialGradient(32, 32, 0, 32, 32, 32);
      g.addColorStop(0, 'rgba(' + rgb[0] + ',' + rgb[1] + ',' + rgb[2] + ',1)');
      g.addColorStop(0.45, 'rgba(' + rgb[0] + ',' + rgb[1] + ',' + rgb[2] + ',0.55)');
      g.addColorStop(1, 'rgba(' + rgb[0] + ',' + rgb[1] + ',' + rgb[2] + ',0)');
      s.fillStyle = g;
      s.fillRect(0, 0, 64, 64);
    }
    makeSprite(inkRGB());

    var drops = [];
    var running = false;

    function spawn(x, y, big) {
      var n = big ? 210 : 75;
      var parts = [];
      // 整滴共有的缓旋：整朵云有同向的翻滚感
      var swirl = (Math.random() < 0.5 ? -1 : 1) * (0.004 + Math.random() * 0.007);
      for (var i = 0; i < n; i++) {
        // 出生在一小团体积里（非单点）
        var bornAng = Math.random() * Math.PI * 2;
        var bornR = Math.pow(Math.random(), 0.7) * (big ? 10 : 7);
        var dir = Math.random() * Math.PI * 2;
        var speed = (big ? 0.5 : 0.35) + Math.pow(Math.random(), 1.5) * (big ? 3.0 : 1.8);
        parts.push({
          x: x + Math.cos(bornAng) * bornR,
          y: y + Math.sin(bornAng) * bornR,
          vx: Math.cos(dir) * speed,
          vy: Math.sin(dir) * speed,
          // 大幅自旋：路径呈螺旋，彼此交叉编织成云而非平行射线
          spin: (Math.random() < 0.5 ? -1 : 1) * (0.012 + Math.random() * 0.024),
          r: 2 + Math.random() * 3,
          a: 0.022 + Math.random() * 0.028,
          life: (big ? 1300 : 1000) + Math.random() * 500,
          age: 0,
        });
      }
      drops.push({
        parts: parts,
        swirl: swirl,
        born: performance.now(),
        nucleus: { x: x, y: y, r: big ? 6 : 4.5, alpha: big ? 0.7 : 0.55, life: big ? 750 : 600 },
        residue: 1500,
      });
      wake();
    }

    var lastT = 0;
    function frame(now) {
      var dt = Math.min(now - (lastT || now), 40);
      lastT = now;
      var step = dt / 16.7;

      // 溶解：新墨浓、旧墨淡——前沿翻滚、尾部消散
      inkCtx.save();
      inkCtx.setTransform(1, 0, 0, 1, 0, 0);
      inkCtx.globalCompositeOperation = 'destination-out';
      inkCtx.fillStyle = 'rgba(0, 0, 0, ' + 0.028 * step + ')';
      inkCtx.fillRect(0, 0, ink.width, ink.height);
      inkCtx.restore();

      inkCtx.save();
      inkCtx.scale(dpr, dpr);

      var alive = false;
      for (var di = drops.length - 1; di >= 0; di--) {
        var d = drops[di];
        var age = now - d.born;

        // 浓核：小实心墨点，快速洇淡
        var nt = age / d.nucleus.life;
        if (nt < 1) {
          var c = inkRGB();
          var nr = d.nucleus.r * (1 + nt * 1.1);
          var na = d.nucleus.alpha * (1 - nt) * (1 - nt);
          var ng = inkCtx.createRadialGradient(d.nucleus.x, d.nucleus.y, 0, d.nucleus.x, d.nucleus.y, nr);
          ng.addColorStop(0, 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + na + ')');
          ng.addColorStop(1, 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',0)');
          inkCtx.fillStyle = ng;
          inkCtx.beginPath();
          inkCtx.arc(d.nucleus.x, d.nucleus.y, nr, 0, Math.PI * 2);
          inkCtx.fill();
          alive = true;
        }

        var anyPart = false;
        for (var i = d.parts.length - 1; i >= 0; i--) {
          var p = d.parts[i];
          p.age += dt;
          var t = p.age / p.life;
          if (t >= 1) {
            d.parts.splice(i, 1);
            continue;
          }
          anyPart = true;
          // 方向持续旋转（自旋 + 整滴缓旋）→ 螺旋路径
          var theta = Math.atan2(p.vy, p.vx) + (p.spin + d.swirl) * step;
          var sp = Math.sqrt(p.vx * p.vx + p.vy * p.vy) * Math.pow(0.972, step);
          p.vx = Math.cos(theta) * sp;
          p.vy = Math.sin(theta) * sp;
          p.x += p.vx * step;
          p.y += p.vy * step;

          // 大而软的墨点，随龄略放大变淡：云雾质感
          inkCtx.globalAlpha = p.a * Math.pow(1 - t, 1.4);
          var pr = p.r * (1 + t * 0.9);
          inkCtx.drawImage(sprite, p.x - pr, p.y - pr, pr * 2, pr * 2);
        }

        if (anyPart || nt < 1) {
          alive = true;
        } else if (age > d.nucleus.life + d.residue) {
          drops.splice(di, 1);
        } else {
          alive = true; // 残余溶解期
        }
      }
      inkCtx.restore();

      // 合成到显示层
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(ink, 0, 0);

      if (alive) {
        requestAnimationFrame(frame);
      } else {
        running = false;
        lastT = 0;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        inkCtx.clearRect(0, 0, ink.width, ink.height);
      }
    }

    function wake() {
      if (!running) {
        running = true;
        requestAnimationFrame(frame);
      }
    }

    // 鼠标划过：滴小墨
    var lastX = -1;
    var lastY = -1;
    document.addEventListener('pointermove', function (e) {
      if (e.pointerType !== 'mouse') return;
      if (lastX < 0) {
        lastX = e.clientX;
        lastY = e.clientY;
        return;
      }
      var dx = e.clientX - lastX;
      var dy = e.clientY - lastY;
      if (dx * dx + dy * dy > 1600) {
        lastX = e.clientX;
        lastY = e.clientY;
        spawn(e.clientX, e.clientY, false);
      }
    });

    // 点击：滴一大滴
    document.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse') return;
      spawn(e.clientX, e.clientY, true);
    });

    // 开场一滴墨
    try {
      if (!sessionStorage.getItem('ink-intro')) {
        sessionStorage.setItem('ink-intro', '1');
        setTimeout(function () {
          spawn(window.innerWidth * 0.5, window.innerHeight * 0.38, true);
        }, 700);
      }
    } catch (e) {
      /* 隐私模式不可用 */
    }

    // 切主题：换墨色、清旧墨
    window.addEventListener('theme-changed', function () {
      makeSprite(inkRGB());
      drops = [];
      inkCtx.clearRect(0, 0, ink.width, ink.height);
    });

    console.info('[听雨·墨] 效果已启用');
  })();
</script>
