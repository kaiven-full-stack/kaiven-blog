---
/**
 * 淡墨笔锋 + 雨滴涟漪：
 * - 鼠标移动时留下短暂、随速度变化的淡墨笔触；
 * - 点击时落下一滴雨，扩散成两圈轻微水纹；
 * - 仅响应鼠标或触控板，不受系统“减少动态效果”设置影响。
 */
---

<canvas
  id="ink-trail"
  class="pointer-events-none fixed inset-0 z-[5] h-full w-full"
  aria-hidden="true"
></canvas>

<script is:inline>
  (function () {
    var canvas = document.getElementById('ink-trail');
    if (!canvas) return;

    var ctx = canvas.getContext('2d');
    if (!ctx) return;

    var dpr = 1;
    var rgb = [43, 42, 38];
    var strokes = [];
    var ripples = [];
    var running = false;
    var lastPoint = null;
    var pendingPoint = null;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(window.innerWidth * dpr);
      canvas.height = Math.floor(window.innerHeight * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function readInk() {
      var value = getComputedStyle(document.documentElement).getPropertyValue('--ink').trim();
      var match = /^#([0-9a-f]{6})$/i.exec(value);
      if (!match) return;

      var color = parseInt(match[1], 16);
      rgb = [(color >> 16) & 255, (color >> 8) & 255, color & 255];
    }

    function rgba(alpha) {
      return 'rgba(' + rgb[0] + ',' + rgb[1] + ',' + rgb[2] + ',' + alpha + ')';
    }

    function isMousePointer(event) {
      // 部分旧浏览器的鼠标 PointerEvent 不提供 pointerType。
      return !event.pointerType || event.pointerType === 'mouse';
    }

    function clearCanvas() {
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
    }

    function clearEffects() {
      strokes = [];
      ripples = [];
      lastPoint = null;
      pendingPoint = null;
      clearCanvas();
    }

    function wake() {
      if (running) return;
      running = true;
      requestAnimationFrame(frame);
    }

    function addStroke(from, to, now) {
      var dx = to.x - from.x;
      var dy = to.y - from.y;
      var distance = Math.sqrt(dx * dx + dy * dy);
      if (distance < 2) return false;

      var elapsed = Math.max(Math.min(to.time - from.time, 50), 1);
      var speed = distance / elapsed;
      var steps = Math.min(28, Math.max(1, Math.ceil(distance / 14)));
      var normalX = -dy / distance;
      var normalY = dx / distance;

      // 将稀疏的高速指针事件补成固定长度的小段，避免快速滑动时断线。
      for (var i = 0; i < steps; i++) {
        var start = i / steps;
        var end = (i + 1) / steps;
        var x1 = from.x + dx * start;
        var y1 = from.y + dy * start;
        var x2 = from.x + dx * end;
        var y2 = from.y + dy * end;
        var segmentLength = distance / steps;
        var bend = (Math.random() - 0.5) * Math.min(2, segmentLength * 0.12);

        strokes.push({
          x1: x1,
          y1: y1,
          x2: x2,
          y2: y2,
          cx: (x1 + x2) * 0.5 + normalX * bend,
          cy: (y1 + y2) * 0.5 + normalY * bend,
          nx: normalX,
          ny: normalY,
          width: Math.max(1.05, Math.min(2.8, 3 - speed * 0.7)),
          alpha: Math.min(0.28, 0.17 + speed * 0.035),
          seed: Math.random(),
          born: now,
          life: 640,
        });
      }

      if (strokes.length > 100) strokes.splice(0, strokes.length - 100);
      wake();
      return true;
    }

    function addRipple(x, y, now) {
      ripples.push({ x: x, y: y, born: now, seed: Math.random() });
      if (ripples.length > 8) ripples.shift();
      wake();
    }

    function drawStroke(stroke, now) {
      var progress = (now - stroke.born) / stroke.life;
      if (progress >= 1) return false;

      var fade = Math.pow(1 - progress, 1.7);

      // 淡淡的湿墨底，让笔触像在宣纸上轻微洇开。
      ctx.strokeStyle = rgba(stroke.alpha * fade * 0.22);
      ctx.lineWidth = stroke.width * (2.6 + progress * 0.8);
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(stroke.x1, stroke.y1);
      ctx.quadraticCurveTo(stroke.cx, stroke.cy, stroke.x2, stroke.y2);
      ctx.stroke();

      // 主笔锋。
      ctx.strokeStyle = rgba(stroke.alpha * fade);
      ctx.lineWidth = stroke.width * (1 - progress * 0.2);
      ctx.beginPath();
      ctx.moveTo(stroke.x1, stroke.y1);
      ctx.quadraticCurveTo(stroke.cx, stroke.cy, stroke.x2, stroke.y2);
      ctx.stroke();

      // 两根细墨丝合在一次描边中绘制，保留纤维感并减少 Canvas 调用。
      ctx.strokeStyle = rgba(stroke.alpha * fade * 0.4);
      ctx.lineWidth = Math.max(0.35, stroke.width * 0.24);
      ctx.beginPath();
      for (var i = 0; i < 2; i++) {
        var side = i === 0 ? -1 : 1;
        var offset = side * stroke.width * (0.55 + stroke.seed * 0.35);
        ctx.moveTo(stroke.x1 + stroke.nx * offset, stroke.y1 + stroke.ny * offset);
        ctx.quadraticCurveTo(
          stroke.cx + stroke.nx * offset * 1.2,
          stroke.cy + stroke.ny * offset * 1.2,
          stroke.x2 + stroke.nx * offset * 0.6,
          stroke.y2 + stroke.ny * offset * 0.6,
        );
      }
      ctx.stroke();

      return true;
    }

    function drawRing(ripple, age, delay, duration, startRadius, endRadius, alpha) {
      var progress = (age - delay) / duration;
      if (progress < 0 || progress >= 1) return;

      var eased = 1 - Math.pow(1 - progress, 3);
      var radius = startRadius + (endRadius - startRadius) * eased;
      var wobble = (ripple.seed - 0.5) * 0.08;

      ctx.strokeStyle = rgba(alpha * Math.pow(1 - progress, 1.5));
      ctx.lineWidth = 0.9;
      ctx.beginPath();
      ctx.ellipse(
        ripple.x,
        ripple.y,
        radius * (1 + wobble),
        radius * (0.48 - wobble * 0.25),
        0,
        0,
        Math.PI * 2,
      );
      ctx.stroke();
    }

    function drawRipple(ripple, now) {
      var age = now - ripple.born;
      if (age >= 980) return false;

      if (age < 220) {
        var dropFade = 1 - age / 220;
        ctx.fillStyle = rgba(0.28 * dropFade);
        ctx.beginPath();
        ctx.arc(ripple.x, ripple.y, 1.5 + age * 0.008, 0, Math.PI * 2);
        ctx.fill();
      }

      drawRing(ripple, age, 0, 760, 3, 25, 0.22);
      drawRing(ripple, age, 120, 860, 5, 34, 0.13);
      return true;
    }

    function frame(now) {
      // 指针事件可能远快于屏幕刷新率；每帧只处理最新位置。
      if (pendingPoint) {
        var point = pendingPoint;
        pendingPoint = null;
        if (lastPoint && addStroke(lastPoint, point, now)) lastPoint = point;
      }

      clearCanvas();

      for (var i = strokes.length - 1; i >= 0; i--) {
        if (!drawStroke(strokes[i], now)) strokes.splice(i, 1);
      }

      for (var j = ripples.length - 1; j >= 0; j--) {
        if (!drawRipple(ripples[j], now)) ripples.splice(j, 1);
      }

      if (pendingPoint || strokes.length || ripples.length) {
        requestAnimationFrame(frame);
      } else {
        running = false;
      }
    }

    document.addEventListener('pointermove', function (event) {
      if (!isMousePointer(event)) return;

      var point = { x: event.clientX, y: event.clientY, time: performance.now() };
      if (!lastPoint) {
        lastPoint = point;
        return;
      }

      pendingPoint = point;
      wake();
    });

    document.addEventListener('pointerdown', function (event) {
      if (!isMousePointer(event)) return;
      addRipple(event.clientX, event.clientY, performance.now());
    });

    document.documentElement.addEventListener('pointerleave', function () {
      lastPoint = null;
      pendingPoint = null;
    });

    window.addEventListener('blur', function () {
      lastPoint = null;
      pendingPoint = null;
    });

    window.addEventListener('resize', resize);
    window.addEventListener('theme-changed', readInk);

    resize();
    readInk();
  })();
</script>
