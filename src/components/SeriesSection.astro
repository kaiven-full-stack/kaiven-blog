---
import type { CollectionEntry } from 'astro:content';
import { SERIES_ORDER, groupPostsBySeries } from '../utils/posts';
import PostCard from './PostCard.astro';
import BrushRule from './BrushRule.astro';

interface Props {
  excludePostId?: string;
}

const { excludePostId } = Astro.props;
const groups = await groupPostsBySeries();

const seriesList: {
  slug: string;
  title: string;
  description: string;
  posts: CollectionEntry<'blog'>[];
  recentPost?: CollectionEntry<'blog'>;
}[] = SERIES_ORDER.map((series) => {
  const posts = groups.find((group) => group.series.id === series.id)?.posts ?? [];
  return {
    slug: series.id,
    title: series.title,
    description: series.description,
    posts,
    recentPost: posts.find((post) => post.id !== excludePostId),
  };
});
---

<section aria-label="系列栏目" class="mt-16">
  <div class="flex items-baseline justify-between gap-4">
    <h2 class="font-brush text-2xl text-ink">系列</h2>
    <span class="text-[13px] text-ink-faint">长题慢写，各成一卷</span>
  </div>

  <div class="mt-8 grid grid-cols-1 gap-10 sm:grid-cols-3 sm:gap-8">
    {
      seriesList.map(({ slug, title, description, posts, recentPost }) => (
        <section class="flex flex-col">
          <a href={`/series/${slug}/`} class="group/title block">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-brush text-[1.35rem] leading-snug text-ink transition-colors group-hover/title:text-cinnabar">
                {title}
              </h3>
              <span class="shrink-0 text-[13px] text-ink-faint">{posts.length} 篇</span>
            </div>
          </a>

          <div class="mt-2 opacity-60">
            <BrushRule />
          </div>

          <p class="mt-3 line-clamp-2 text-[14px] leading-relaxed text-ink-soft">
            {description}
          </p>

          {recentPost && (
            <div class="mt-4">
              <p class="text-xs tracking-[0.25em] text-ink-faint">最近</p>
              <div class="mt-2">
                <PostCard post={recentPost} variant="compact" />
              </div>
            </div>
          )}

          <a
            href={`/series/${slug}/`}
            class="mt-auto pt-4 text-sm text-cinnabar transition-opacity hover:opacity-75"
          >
            全部 {posts.length} 篇 →
          </a>
        </section>
      ))
    }
  </div>
</section>
