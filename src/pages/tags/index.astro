---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);

const tagCount = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCount.set(tag, (tagCount.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="标签" description="听雨 · 文章标签">
  <section class="pt-12 sm:pt-16">
    <h1 class="font-brush text-4xl text-ink">标签</h1>
    <p class="mt-3 text-[15px] text-ink-soft">随手贴的，不讲究归类。</p>

    <div class="mt-12 flex flex-wrap gap-3">
      {
        tags.map(([tag, count]) => (
          <a
            href={`/tags/${tag}/`}
            class="tag-pill flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-[15px]"
          >
            {tag}
            <span class="text-xs text-ink-faint">{count}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
