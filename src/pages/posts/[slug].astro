---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Giscus from '../../components/Giscus.astro';
import Seal from '../../components/Seal.astro';
import Toc from '../../components/Toc.astro';
import ReadingDock from '../../components/ReadingDock.astro';
import { cnDate } from '../../utils/date';
import { readingTime } from '../../utils/readingTime';
import { getAdjacentPosts, getPublishedPosts, getSeriesForPost } from '../../utils/posts';
import { getRelatedPosts } from '../../utils/graph';
import RelatedPosts from '../../components/RelatedPosts.astro';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, tags, category } = post.data;
const body = post.body ?? '';
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const readTime = readingTime(body);
const isTechnical = category !== 'life';
const series = getSeriesForPost(post);
const { prev: seriesPrev, next: seriesNext } = await getAdjacentPosts(post);
const related = await getRelatedPosts(post);
---

<BaseLayout title={title} description={description}>
  <!-- relative 给桌面 TOC 侧栏做定位上下文；data-reading 是 ReadingDock 的根标记 -->
  <article
    class:list={['post relative pt-12 sm:pt-16', isTechnical ? 'post--technical' : 'post--life']}
    data-reading
    data-pagefind-body
  >
    <header class="mx-auto max-w-[34em] text-center">
      <p class="mb-3 text-[13px] tracking-[0.25em] text-ink-faint" data-pagefind-ignore>
        <a href={`/series/${series.id}/`} class="transition-colors hover:text-cinnabar">{series.title}</a>
      </p>
      <h1 class:list={[
        'text-[2.1rem] leading-snug text-ink sm:text-4xl',
        isTechnical ? 'font-body font-bold' : 'font-brush',
      ]}>{title}</h1>
      <div class="mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-[13px] text-ink-faint">
        <time datetime={pubDate.toISOString().slice(0, 10)}>{cnDate(pubDate)}</time>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>改于 {cnDate(updatedDate)}</span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span data-pagefind-ignore>{readTime.label}</span>
        {
          tags.length > 0 && (
            <>
              <span aria-hidden="true">·</span>
              <span class="flex gap-2">
                {tags.map((tag) => (
                  <a href={`/tags/${tag}/`} class="transition-colors hover:text-cinnabar">
                    {tag}
                  </a>
                ))}
              </span>
            </>
          )
        }
      </div>
    </header>

    <Toc headings={tocHeadings} />

    <div class="prose-ink mx-auto mt-12 max-w-[34em]">
      <Content />

      <!-- 落款：闲章 -->
      <div class="mt-16 flex justify-end">
        <div class="flex flex-col items-center gap-2">
          <Seal chars="雨窗闲笔" size="md" />
          <span class="text-xs text-ink-faint">记于 {cnDate(pubDate)}</span>
        </div>
      </div>
    </div>
  </article>

  <nav class="series-nav mx-auto mt-10 max-w-[34em]" data-pagefind-ignore aria-label="系列导航">
    <p class="series-nav-title text-[13px] tracking-wide text-ink-faint">
      系列 <a href={`/series/${series.id}/`} class="text-ink-soft transition-colors hover:text-cinnabar">{series.title}</a>
    </p>
    <div class="mt-3 flex items-start justify-between gap-4 text-sm">
      {seriesPrev ? (
        <a class="series-link min-w-0" href={`/posts/${seriesPrev.id}/`}>
          <span class="block text-xs text-ink-faint">上一篇</span>
          <span class="block truncate text-ink-soft transition-colors hover:text-cinnabar">
            {seriesPrev.data.title}
          </span>
        </a>
      ) : (
        <span aria-hidden="true" />
      )}
      {seriesNext ? (
        <a class="series-link min-w-0 text-right" href={`/posts/${seriesNext.id}/`}>
          <span class="block text-xs text-ink-faint">下一篇</span>
          <span class="block truncate text-ink-soft transition-colors hover:text-cinnabar">
            {seriesNext.data.title}
          </span>
        </a>
      ) : (
        <span aria-hidden="true" />
      )}
    </div>
  </nav>

  <RelatedPosts related={related} />

  <nav class="mt-10 flex justify-between text-sm text-ink-soft">
    <a href="/" class="transition-colors hover:text-cinnabar">← 回首页</a>
    <a href="/archives/" class="transition-colors hover:text-cinnabar">全部归档 →</a>
  </nav>

  <Giscus />
  <ReadingDock />
</BaseLayout>
