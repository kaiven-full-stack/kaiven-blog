---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { cnYear } from '../utils/date';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 按年分组，保持时间倒序
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title="归档" description="听雨 · 全部文章归档">
  <section class="pt-12 sm:pt-16">
    <h1 class="font-brush text-4xl text-ink">归档</h1>
    <p class="mt-3 text-[15px] text-ink-soft">共 {posts.length} 篇，按时间倒序。</p>

    <div class="mt-12 flex flex-col gap-14">
      {
        years.map((year) => (
          <section>
            <div class="flex items-baseline gap-4">
              <h2 class="font-brush text-2xl text-ink">{cnYear(new Date(year, 0))}年</h2>
              <span class="text-sm text-ink-faint">{byYear.get(year)!.length} 篇</span>
            </div>
            <ul class="mt-6 flex flex-col gap-4">
              {byYear.get(year)!.map((post) => (
                <li class="flex items-baseline gap-4">
                  <time
                    datetime={post.data.pubDate.toISOString().slice(0, 10)}
                    class="shrink-0 font-mono text-[13px] tabular-nums text-ink-faint"
                  >
                    {String(post.data.pubDate.getMonth() + 1).padStart(2, '0')}-
                    {String(post.data.pubDate.getDate()).padStart(2, '0')}
                  </time>
                  <a
                    href={`/posts/${post.id}/`}
                    class="text-[15px] leading-snug text-ink transition-colors hover:text-cinnabar"
                  >
                    {post.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
